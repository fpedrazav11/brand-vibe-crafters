---
import { site } from '../data/site';
const year = new Date().getFullYear();
const links = [
  ['#servicios', 'Servicios'],
  ['#casos', 'Casos'],
  ['#membresias', 'Membresías'],
  ['#metodo', 'Cómo trabajamos'],
  ['#contacto', 'Contacto'],
  ['#privacidad', 'Aviso de privacidad'],
];
---
<footer style="background: #1A002B; color: #CFC4DA">
<div style="max-width: 1240px; margin: 0 auto; padding: 36px clamp(16px, 4vw, 40px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 18px 32px; font-size: 14px">
<img src={site.logoLight} alt={site.tagline} loading="lazy" style="height: 36px; width: auto; display: block">
<nav class="bv-nav" aria-label="Pie de página" style="display: flex; flex-wrap: wrap; gap: 10px 22px">
{links.map(([href, label]) => <a href={href} style="color: #CFC4DA">{label}</a>)}
</nav>
<p style="margin: 0">© {year} {site.legalName} · {site.city}, {site.countryName}</p>
</div>
</footer>
