---
import data from '../data/metodo.json';
---
<section id="metodo" style="background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: clamp(36px, 5vw, 72px)">
<div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.title}</h2>
<p style="margin: 0; font-size: 17px; line-height: 1.6; color: #50514F">{data.text}</p>
{data.results.length > 0 && (
<div style="background: #2A0044; color: #FFFFFF; border-radius: 22px; padding: 26px 24px; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 16px; font-weight: 700">{data.resultsTitle}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; font-size: 15px; color: #E6DDF0">
{data.results.map((r) => <li style="display: flex; gap: 10px; align-items: flex-start"><span aria-hidden="true" style="flex: 0 0 auto; width: 8px; height: 8px; border-radius: 50%; background: #59C3C3; margin-top: 7px"></span><span>{r}</span></li>)}
</ul>
</div>
)}
</div>
<ol style="flex: 1.4 1 520px; min-width: 0; margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
{data.steps.map((s, i) => (
<li style="border: 1px solid #E4DDEB; border-radius: 20px; padding: 22px 22px 24px; display: flex; flex-direction: column; gap: 10px; background: #FFFFFF">
<div style="display: flex; align-items: center; justify-content: space-between; gap: 10px">
<span style="font-size: 28px; font-weight: 800; color: #7678ED">{String(i + 1).padStart(2, '0')}</span>
{s.badge && <span style="font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: #E3F5F5; color: #1F5F5F">{s.badge}</span>}
</div>
<h3 style="margin: 0; font-size: 18px; font-weight: 700; color: #2A0044">{s.title}</h3>
<p style="margin: 0; font-size: 14.5px; line-height: 1.6; color: #50514F">{s.text}</p>
</li>
))}
</ol>
</div>
</section>
