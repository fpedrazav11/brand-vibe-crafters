---
import data from '../data/diferencia.json';
import { icons } from '../data/icons';
---
<section id="diferencia" style="background: #F6F3F9">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 104px) clamp(16px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: clamp(32px, 5vw, 72px); align-items: center">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(32px, 4vw, 54px); line-height: 1.08; font-weight: 800; color: #2A0044">{data.title}</h2>
</div>
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<p style="margin: 0; font-size: 18px; line-height: 1.7; color: #50514F">{data.text}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px">
{data.items.map((it) => (
<li style="display: flex; gap: 14px; align-items: center; background: #FFFFFF; border-radius: 16px; padding: 16px 18px; font-size: 16px; font-weight: 600; color: #2A0044"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3A015C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 auto" set:html={icons[it.icon] ?? icons.calendario} />{it.text}</li>
))}
</ul>
</div>
</div>
</section>
