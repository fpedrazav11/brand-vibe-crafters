---
import { site, wa } from '../data/site';
import hero from '../data/hero.json';
---
<section id="inicio" style="position: relative; background: linear-gradient(170deg, #FFFFFF 0%, #F6F3F9 100%); color: #2A0044; overflow: hidden">
<img src={site.logo} alt="" aria-hidden="true" style="position: absolute; right: -6%; bottom: -12%; width: 70%; max-width: 980px; opacity: 0.045; pointer-events: none">
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 8vw, 104px) clamp(16px, 4vw, 40px) clamp(56px, 8vw, 96px); display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
<div style="flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 26px">
<p style="margin: 0; display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #3A015C"><span aria-hidden="true" style="width: 32px; height: 3px; border-radius: 3px; background: #59C3C3"></span>{hero.kicker}</p>
<h1 style="margin: 0; font-size: clamp(38px, 5.4vw, 70px); line-height: 1.04; font-weight: 800; letter-spacing: -0.02em; color: #2A0044">{hero.title}</h1>
<p style="margin: 0; font-size: clamp(17px, 1.6vw, 20px); line-height: 1.6; font-weight: 400; color: #50514F; max-width: 560px">{hero.text}</p>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px">
<a class="bv-btn" href={wa(site.ctaMessage)} target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 10px; background: #3A015C; color: #FFFFFF; font-weight: 700; font-size: 16px; padding: 16px 28px; border-radius: 999px; text-decoration: none">{hero.ctaLabel || site.ctaLabel}
<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
{hero.secondaryLabel && <a class="bv-btn" href={hero.secondaryHref} style="display: inline-flex; align-items: center; color: #3A015C; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1.5px solid #3A015C; text-decoration: none">{hero.secondaryLabel}</a>}
</div>
</div>
<div style="flex: 1 1 360px; min-width: 0; display: flex; justify-content: center">
<div style="position: relative; width: 100%; max-width: 440px">
<div style="position: absolute; inset: 22px -22px -22px 22px; border-radius: 32px; background: #59C3C3; opacity: 0.9"></div>
<img src={hero.image} alt={hero.imageAlt} width="440" height="550" fetchpriority="high" decoding="async" style="position: relative; display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; border-radius: 32px">
<div style="position: absolute; left: -14px; bottom: 28px; background: #FFFFFF; color: #2A0044; padding: 14px 18px; border-radius: 18px; box-shadow: 0 14px 34px rgba(0,0,0,0.25)">
<p style="margin: 0; font-size: 15px; font-weight: 700">{hero.badgeName}</p>
<p style="margin: 2px 0 0; font-size: 13px; color: #50514F">{hero.badgeRole}</p>
</div>
</div>
</div>
</div>
</section>
