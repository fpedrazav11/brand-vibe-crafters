---
import data from '../data/privacidad.json';
---
<section id="privacidad" aria-label="Aviso de privacidad" style="background: #1A002B; color: #CFC4DA; border-bottom: 1px solid rgba(255,255,255,0.08)">
<div style="max-width: 1240px; margin: 0 auto; padding: 28px clamp(16px, 4vw, 40px) 8px">
<details id="bv-aviso" style="font-size: 14px; line-height: 1.7">
<summary style="cursor: pointer; font-size: 15px; font-weight: 700; color: #FFFFFF; padding: 8px 0">{data.summary}</summary>
<div style="padding: 12px 0 20px; max-width: 900px">
{data.items.map((it) => <p style="margin: 0 0 12px"><strong style="color: #FFFFFF">{it.title}.</strong> {it.text}</p>)}
{data.closing && <p style="margin: 0">{data.closing}</p>}
</div>
</details>
</div>
</section>
