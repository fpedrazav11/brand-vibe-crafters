---
import data from '../data/cifras.json';
import { site } from '../data/site';
---
<section aria-label={`${site.name} en números`} style="background: #F6F3F9">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 5vw, 64px) clamp(16px, 4vw, 40px); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px 56px">
{data.items.map((c) => (
<div style="display: flex; align-items: center; gap: 22px; border-left: 3px solid #59C3C3; padding-left: 22px">
<p style="margin: 0; font-size: clamp(44px, 5vw, 64px); font-weight: 800; color: #3A015C; line-height: 1">{c.value}</p>
<p style="margin: 0; font-size: 16px; line-height: 1.55; color: #50514F; max-width: 340px">{c.text}</p>
</div>
))}
</div>
</section>
