---
import data from '../data/nosotros.json';
import { wa, ig, initials } from '../data/site';
const palette = [
  'background: #3A015C; color: #FFFFFF',
  'background: #59C3C3; color: #2A0044',
  'background: #7678ED; color: #FFFFFF',
  'background: #EBEBEB; color: #3A015C',
];
---
<section id="nosotros" style="background: #F6F3F9">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-direction: column; gap: 56px">
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: clamp(32px, 5vw, 72px)">
<div style="flex: 1 1 340px; min-width: 0; max-width: 480px; margin: 0 auto">
<img src={data.image} alt={data.imageAlt} loading="lazy" decoding="async" style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 28px">
</div>
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.name}</h2>
{data.paragraphs.map((p) => <p style="margin: 0; font-size: 17px; line-height: 1.7; color: #50514F">{p}</p>)}
<div style="display: flex; flex-wrap: wrap; gap: 12px; padding-top: 4px">
<a class="bv-btn" href={wa(data.ctaMessage)} target="_blank" rel="noopener" style="background: #3A015C; color: #FFFFFF; font-weight: 700; font-size: 15px; padding: 14px 24px; border-radius: 999px; text-decoration: none">{data.ctaLabel}</a>
{data.instagram && <a class="bv-btn" href={ig(data.instagram)} target="_blank" rel="noopener" style="color: #3A015C; font-weight: 600; font-size: 15px; padding: 13px 22px; border-radius: 999px; border: 1.5px solid #3A015C; text-decoration: none">@{data.instagram.replace(/^@/, '')}</a>}
</div>
</div>
</div>
<div style="display: flex; flex-direction: column; gap: 22px">
<h3 style="margin: 0; font-size: 24px; font-weight: 800; color: #2A0044">{data.teamTitle}</h3>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px">
{data.team.map((m, i) => (
<div style="background: #FFFFFF; border-radius: 20px; padding: 20px; display: flex; align-items: center; gap: 14px">
{m.photo
  ? <img src={m.photo} alt={m.name} loading="lazy" style="flex: 0 0 auto; width: 54px; height: 54px; border-radius: 50%; object-fit: cover; display: block" />
  : <div aria-hidden="true" style={`flex: 0 0 auto; width: 54px; height: 54px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 17px; ${palette[i % palette.length]}`}>{initials(m.name)}</div>}
<div style="min-width: 0">
<p style="margin: 0; font-size: 15px; font-weight: 700; color: #2A0044">{m.name}</p>
<p style="margin: 3px 0 0; font-size: 13px; line-height: 1.4; color: #50514F">{m.role}</p>
</div>
</div>
))}
</div>
</div>
</div>
</section>
