---
import data from '../data/contacto.json';
import { site, wa, ig } from '../data/site';
const label = 'margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #59C3C3';
---
<section id="contacto" style="position: relative; background: linear-gradient(160deg, #3A015C 0%, #2A0044 100%); color: #FFFFFF; overflow: hidden">
<img src={site.logoLight} alt="" aria-hidden="true" style="position: absolute; left: -8%; top: -20%; width: 60%; max-width: 820px; opacity: 0.05; pointer-events: none">
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-wrap: wrap; gap: clamp(36px, 5vw, 72px); align-items: center">
<div style="flex: 1.2 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 22px">
<h2 style="margin: 0; font-size: clamp(32px, 4.4vw, 58px); line-height: 1.06; font-weight: 800">{data.title}</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.6; font-weight: 300; color: #E6DDF0">{data.text}</p>
<ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; font-size: 16px">
{data.bullets.map((b) => <li style="display: flex; gap: 12px; align-items: center"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#59C3C3" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex: 0 0 auto"><path d="M20 6 9 17l-5-5"></path></svg>{b}</li>)}
</ul>
<div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 6px">
<a class="bv-btn" href={wa(site.ctaMessage)} target="_blank" rel="noopener" style="background: #59C3C3; color: #2A0044; font-weight: 700; font-size: 16px; padding: 16px 28px; border-radius: 999px; text-decoration: none">{site.ctaLabel}</a>
<a class="bv-btn" href={`mailto:${site.email}`} style="color: #FFFFFF; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1.5px solid rgba(255,255,255,0.45); text-decoration: none">{site.email}</a>
</div>
</div>
<address style="font-style: normal; flex: 1 1 340px; min-width: 0; background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-radius: 26px; padding: 30px 28px; display: flex; flex-direction: column; gap: 20px">
<div>
<p style={label}>WhatsApp</p>
<p style="margin: 6px 0 0; font-size: 20px; font-weight: 700"><a href={wa(site.ctaMessage)} target="_blank" rel="noopener" style="color: #FFFFFF; text-decoration: none">{site.whatsappDisplay}</a></p>
</div>
<div>
<p style={label}>Instagram</p>
<p style="margin: 6px 0 0; font-size: 20px; font-weight: 700"><a href={ig(site.instagram)} target="_blank" rel="noopener" style="color: #FFFFFF; text-decoration: none">@{site.instagram}</a></p>
</div>
{data.hours.length > 0 && (
<div>
<p style={label}>Horario</p>
<p style="margin: 6px 0 0; font-size: 16px; line-height: 1.6; color: #E6DDF0">{data.hours.map((h, i) => <>{i > 0 && <br />}{h}</>)}</p>
</div>
)}
<div>
<p style={label}>Dónde estamos</p>
<p style="margin: 6px 0 0; font-size: 16px; color: #E6DDF0">{data.location}</p>
</div>
</address>
</div>
</section>
