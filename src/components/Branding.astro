---
import data from '../data/branding.json';
---
<section id="branding" style="background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px">
<div style="flex: 1 1 520px; min-width: 0">
<p style="margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.title}</h2>
</div>
<p style="flex: 1 1 360px; min-width: 0; margin: 0; font-size: 17px; line-height: 1.6; color: #50514F">{data.intro}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 18px">
{data.items.map((b) => (
<button type="button" class="bv-tile" data-lb-src={b.src} data-lb-name={b.name} data-lb-kind={b.kind} aria-label={`Ver ${b.name} en grande`} style="cursor: pointer; padding: 0; border: 0; background: #F6F3F9; border-radius: 20px; overflow: hidden; text-align: left; font-family: inherit; display: flex; flex-direction: column">
<div style="overflow: hidden; aspect-ratio: 4 / 5; width: 100%">
<img src={b.src} alt={b.name} loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block" />
</div>
<div style="padding: 14px 16px 16px">
<p style="margin: 0; font-size: 16px; font-weight: 700; color: #2A0044">{b.name}</p>
<p style="margin: 3px 0 0; font-size: 13px; color: #50514F">{b.kind}</p>
</div>
</button>
))}
</div>
</div>
</section>
