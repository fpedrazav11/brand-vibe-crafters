---
import data from '../data/servicios.json';
import { icons } from '../data/icons';
---
<section id="servicios" style="background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-direction: column; gap: 44px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px">
<div style="flex: 1 1 520px; min-width: 0">
<p style="margin: 0 0 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.title}</h2>
</div>
<p style="flex: 1 1 360px; min-width: 0; margin: 0; font-size: 17px; line-height: 1.6; color: #50514F">{data.intro}</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px">
{data.items.map((s) => (
<article class="bv-card" style="background: #FFFFFF; border: 1px solid #E4DDEB; border-radius: 22px; padding: 28px 24px; display: flex; flex-direction: column; gap: 14px">
<div style="width: 52px; height: 52px; border-radius: 16px; background: #F1EAF7; color: #3A015C; display: flex; align-items: center; justify-content: center">
<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[s.icon] ?? ''} />
</div>
<h3 style="margin: 0; font-size: 19px; font-weight: 700; color: #2A0044">{s.title}</h3>
<p style="margin: 0; font-size: 15px; line-height: 1.6; color: #50514F">{s.text}</p>
</article>
))}
</div>
</div>
</section>
