---
import data from '../data/charlas.json';
import { wa } from '../data/site';
---
<section id="charlas" style="background: #FFFFFF">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-wrap: wrap; align-items: center; gap: clamp(32px, 5vw, 64px)">
<div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.title}</h2>
<p style="margin: 0; font-size: 17px; line-height: 1.7; color: #50514F">{data.text}</p>
<div style="display: flex; flex-wrap: wrap; gap: 10px">
{data.tags.map((t) => <span style="font-size: 14px; font-weight: 700; padding: 9px 16px; border-radius: 999px; background: #F1EAF7; color: #3A015C">{t}</span>)}
</div>
<div><a class="bv-btn" href={wa(data.ctaMessage)} target="_blank" rel="noopener" style="display: inline-block; background: #3A015C; color: #FFFFFF; font-weight: 700; font-size: 15px; padding: 14px 24px; border-radius: 999px; text-decoration: none">{data.ctaLabel}</a></div>
</div>
<div style="flex: 1 1 420px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px">
{data.images.slice(0, 2).map((im, i) => <img src={im.src} alt={im.alt} loading="lazy" decoding="async" style={`width: 100%; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 22px; display: block${i === 1 ? '; margin-top: 36px' : ''}`}>)}
</div>
</div>
</section>
