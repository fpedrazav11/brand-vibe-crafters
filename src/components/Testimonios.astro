---
import data from '../data/testimonios.json';
---
<section id="testimonios" style="background: #F6F3F9">
<div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8vw, 112px) clamp(16px, 4vw, 40px); display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 760px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #7678ED">{data.kicker}</p>
<h2 style="margin: 0; font-size: clamp(30px, 3.6vw, 46px); line-height: 1.1; font-weight: 800; color: #2A0044">{data.title}</h2>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 520px), 1fr)); gap: 22px">
{data.items.map((t) => (
<figure style="margin: 0; background: #FFFFFF; border-radius: 26px; padding: clamp(18px, 2.4vw, 26px); display: flex; flex-wrap: wrap; gap: 24px; align-items: center">
{t.video && (
<div style="flex: 0 1 230px; min-width: 200px; margin: 0 auto">
<video src={t.video} poster={t.poster || undefined} controls preload="none" playsinline aria-label={`Testimonio en video de ${t.name}`} style="display: block; width: 100%; aspect-ratio: 9 / 16; object-fit: cover; border-radius: 18px; background: #14001F"></video>
</div>
)}
<div style="flex: 1 1 240px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
<svg width="40" height="32" viewBox="0 0 40 32" aria-hidden="true"><path d="M0 32V18C0 8 5 2 15 0l2 5c-5 2-7 5-7 9h7v18zm23 0V18c0-10 5-16 15-18l2 5c-5 2-7 5-7 9h7v18z" fill="#59C3C3"></path></svg>
<blockquote style="margin: 0; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.55; font-weight: 500; color: #2A0044">“{t.quote}”</blockquote>
<figcaption style="display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 16px; font-weight: 800; color: #2A0044">{t.name}</span>
<span style="font-size: 14px; color: #50514F">{t.role}</span>
</figcaption>
</div>
</figure>
))}
</div>
</div>
</section>
