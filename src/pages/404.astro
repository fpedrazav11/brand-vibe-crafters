---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, wa } from '../data/site';
---
<BaseLayout title={`Página no encontrada | ${site.name}`} description="La página que buscas no existe o cambió de dirección." noindex schema={false}>
  <Header />
  <main style="min-height: 60vh; display: flex; align-items: center; background: linear-gradient(170deg, #FFFFFF 0%, #F6F3F9 100%)">
    <div style="max-width: 760px; margin: 0 auto; padding: 96px clamp(16px, 4vw, 40px); display: flex; flex-direction: column; gap: 22px; text-align: center; align-items: center">
      <p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #7678ED">Error 404</p>
      <h1 style="margin: 0; font-size: clamp(34px, 5vw, 58px); line-height: 1.06; font-weight: 800; color: #2A0044">Esta página no está en La Mesa.</h1>
      <p style="margin: 0; font-size: 18px; line-height: 1.6; color: #50514F">Puede que el enlace haya cambiado. Vuelve al inicio o escríbenos y te ayudamos.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 14px; justify-content: center">
        <a class="bv-btn" href="/" style="background: #3A015C; color: #FFFFFF; font-weight: 700; font-size: 16px; padding: 16px 28px; border-radius: 999px; text-decoration: none">Volver al inicio</a>
        <a class="bv-btn" href={wa(site.ctaMessage)} target="_blank" rel="noopener" style="color: #3A015C; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1.5px solid #3A015C; text-decoration: none">Escríbenos por WhatsApp</a>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
