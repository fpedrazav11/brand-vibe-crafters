---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Clientes from '../components/Clientes.astro';
import Cifras from '../components/Cifras.astro';
import Servicios from '../components/Servicios.astro';
import Diferencia from '../components/Diferencia.astro';
import Casos from '../components/Casos.astro';
import Testimonios from '../components/Testimonios.astro';
import Branding from '../components/Branding.astro';
import Proyectos from '../components/Proyectos.astro';
import Membresias from '../components/Membresias.astro';
import Metodo from '../components/Metodo.astro';
import Nosotros from '../components/Nosotros.astro';
import Charlas from '../components/Charlas.astro';
import Contacto from '../components/Contacto.astro';
import Privacidad from '../components/Privacidad.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---
<BaseLayout>
  <div style="width: 100%; min-height: 100vh; background: #FFFFFF; overflow-x: hidden">
    <Header />
    <main>
      <Hero />
      <Clientes />
      <Cifras />
      <Servicios />
      <Diferencia />
      <Casos />
      <Testimonios />
      <Branding />
      <Proyectos />
      <Membresias />
      <Metodo />
      <Nosotros />
      <Charlas />
      <Contacto />
      <Privacidad />
    </main>
    <Footer />
    <Lightbox />
  </div>
</BaseLayout>
